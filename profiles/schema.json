{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jadal regime profile",
  "description": "Customisable per-data-type pipeline profile. Selected deterministically by jadal/regimes/router.py from window descriptors; the choice is part of the receipt.",
  "type": "object",
  "required": ["name", "version", "sampling", "features", "model", "thresholds", "evidence"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "sampling": {
      "type": "object",
      "required": ["fps", "window_s", "temporal_policy"],
      "properties": {
        "fps": {"type": "number"},
        "window_s": {"type": "number"},
        "temporal_policy": {"type": "string"},
        "probe_every_k_windows": {"type": "integer"},
        "early_exit_s": {"type": ["number", "null"]}
      }
    },
    "features": {
      "type": "object",
      "required": ["set"],
      "properties": {
        "set": {"type": "string", "enum": ["pixel26", "eg2", "both", "pixel26_lite"]},
        "work_res": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "model": {
      "type": "object",
      "required": ["head", "weights"],
      "properties": {
        "head": {"type": "string"},
        "weights": {"type": "string"},
        "per_regime_threshold": {"type": "boolean"}
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["accept", "reject"],
      "properties": {
        "accept": {"type": "number"},
        "reject": {"type": "number"},
        "description": "score >= accept -> usable; <= reject -> unusable; between -> abstain/review"
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "mosaic": {"type": "boolean"},
        "required_fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
